---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <div class="py-20 text-center">
    <h1 class="text-5xl font-black text-white">404</h1>
    <p class="mt-4 text-zinc-400">This page doesn't exist.</p>
    <a href="/" class="btn mt-8">Back to the directory</a>
  </div>
</Base>
