---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import Faq from '../../components/Faq.astro';
import { getEntry, getEntries } from 'astro:content';
import { formatDate, getAlternatives, getTools, hostname, outboundRel, outboundUrl, pricingLabel } from '../../lib/data';
import { breadcrumbSchema, faqSchema, softwareSchema } from '../../lib/schema';
import { battleTitle, getBattlesFor } from '../../lib/battles';
import { fitDescription, fitTitle } from '../../lib/seo';

export async function getStaticPaths() {
  return (await getTools()).map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}
const { tool } = Astro.props;
const d = tool.data;
const category = (await getEntry(d.category))!;
const tags = await getEntries(d.tags);
const alternatives = await getAlternatives(tool, 6);
const battles = await getBattlesFor(tool.id);
const crumbs = [
  { name: category.data.name, href: `/category/${category.id}` },
  { name: d.name, href: `/tool/${tool.id}` },
];
const faq = [
  { q: `Is ${d.name} free?`, a: d.freeTier ? `${pricingLabel(d.pricing)}. Free tier: ${d.freeTier}.` : d.pricing === 'paid' ? `No, ${d.name} is a paid tool.` : `${d.name} is listed as ${pricingLabel(d.pricing).toLowerCase()}. Check the official site for current limits.` },
  { q: `What can ${d.name} do?`, a: `${d.tagline}. Key features: ${d.features.join(', ')}.` },
  { q: `What are the best ${d.name} alternatives?`, a: `Popular alternatives include ${alternatives.slice(0, 4).map((a) => a.data.name).join(', ')}.` },
];
---
<Base
  title={fitTitle([`${d.name}: Features, Pricing & Alternatives`, `${d.name}: Pricing & Alternatives`, `${d.name} Review & Pricing`, d.name])}
  description={fitDescription([`${d.name}: ${d.tagline}.`, `Pricing, free plan, key features and ${d.name} alternatives compared.`, 'Pricing and the best alternatives.'])}
  schema={[breadcrumbSchema(crumbs), softwareSchema(tool), faqSchema(faq)]}
>
  <Breadcrumbs items={crumbs} />
  <div class="flex flex-col gap-8 lg:flex-row">
    <article class="flex-1">
      <div class="flex items-center gap-4">
        <ToolIcon tool={tool} size={64} />
        <div>
          <h1 class="text-3xl font-black text-white sm:text-4xl">{d.name}</h1>
          <p class="text-zinc-500">
            {hostname(tool)}
            {d.listing === 'badge' && <span class="ml-2 text-emerald-400">✓ Verified on RapRank</span>}
            {d.listing === 'sponsor' && <span class="ml-2 text-amber-400">Sponsored</span>}
          </p>
        </div>
      </div>
      <p class="mt-6 text-xl text-zinc-300">{d.tagline}.</p>
      <h2 class="mb-3 mt-10 text-xl font-bold text-white">Key features</h2>
      <ul class="list-inside list-disc space-y-1 text-zinc-300">
        {d.features.map((f) => <li>{f}</li>)}
      </ul>
      <Faq items={faq} />
    </article>
    <aside class="w-full space-y-4 lg:w-80">
      <div class="card space-y-4">
        <a href={outboundUrl(tool)} target="_blank" rel={outboundRel(tool)} class="btn w-full justify-center">Visit {d.name} ↗</a>
        <dl class="space-y-3 text-sm">
          <div><dt class="text-zinc-500">Pricing</dt><dd class="text-white">{pricingLabel(d.pricing)}</dd></div>
          {d.freeTier && <div><dt class="text-zinc-500">Free tier / plans</dt><dd class="text-white">{d.freeTier}</dd></div>}
          <div><dt class="text-zinc-500">Category</dt><dd><a href={`/category/${category.id}`} class="text-brand hover:underline">{category.data.name}</a></dd></div>
        </dl>
        {tags.length > 0 && <div class="flex flex-wrap gap-2">{tags.map((t) => <a href={`/tag/${t.id}`} class="chip">{t.data.name}</a>)}</div>}
        <p class="text-xs text-zinc-600">{d.pricingCheckedAt ? `Pricing checked by hand on ${formatDate(d.pricingCheckedAt)}. ` : ''}Pricing changes often. Check the official site before you buy.</p>
        {d.listing === 'free' && <p class="text-xs text-zinc-600">Is this your tool? <a href="/badge" class="text-brand hover:underline">Get verified</a></p>}
      </div>
      {battles.map(({ battle, a, b }) => <a href={`/battle/${battle.id}`} class="card block text-sm text-zinc-300 hover:border-brand">🥊 Blind test: {battleTitle(a, b)} →</a>)}
      {d.alternativesPage && <a href={`/alternatives/${tool.id}`} class="card block text-sm text-zinc-300 hover:border-brand">See all {d.name} alternatives →</a>}
    </aside>
  </div>
  <section class="mt-14">
    <h2 class="mb-5 text-2xl font-bold text-white">{d.name} alternatives</h2>
    <ToolGrid tools={alternatives} />
  </section>
</Base>
