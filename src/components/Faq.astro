---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="mt-14">
    <h2 class="mb-4 text-2xl font-bold text-white">FAQ</h2>
    <div class="space-y-3">
      {items.map((f) => (
        <details class="card">
          <summary class="cursor-pointer font-semibold text-white">{f.q}</summary>
          <p class="mt-3 text-zinc-400">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
