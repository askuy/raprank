---
import { outboundUrl, pricingLabel, type Tool } from '../lib/data';
interface Props { tools: Tool[] }
const { tools } = Astro.props;
---
<div class="overflow-x-auto rounded-xl border border-zinc-800">
  <table class="w-full text-left text-sm">
    <thead class="bg-zinc-900 text-zinc-400">
      <tr><th class="p-3">#</th><th class="p-3">Tool</th><th class="p-3">Pricing</th><th class="p-3">Free tier</th><th class="p-3">Best for</th><th class="p-3"></th></tr>
    </thead>
    <tbody class="divide-y divide-zinc-800">
      {tools.map((t, i) => (
        <tr>
          <td class="p-3 text-zinc-500">{i + 1}</td>
          <td class="p-3 font-semibold"><a href={`/tool/${t.id}`} class="text-white hover:text-brand">{t.data.name}</a></td>
          <td class="p-3">{pricingLabel(t.data.pricing)}</td>
          <td class="p-3 text-zinc-400">{t.data.freeTier ?? '—'}</td>
          <td class="p-3 text-zinc-400">{t.data.features[0]}</td>
          <td class="p-3"><a href={outboundUrl(t)} target="_blank" rel="nofollow noopener sponsored" class="text-brand hover:underline">Visit ↗</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
