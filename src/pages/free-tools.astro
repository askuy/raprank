---
import { webPageSchema } from '../lib/schema';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { FREE_TOOLS } from '../lib/site';
---
<Base title="Free Rap Tools: Lyrics & Rap Name Generators" description="Free browser-based rap tools from RapRank: a rap lyrics generator for rhyming verses and a rap name generator for stage names. No sign-up, no limits." schema={[webPageSchema('CollectionPage', 'Free rap tools', '/free-tools', 'Free rap lyrics and rap name generators.')]}>
  <Breadcrumbs items={[{ name: 'Free Tools', href: '/free-tools' }]} />
  <h1 class="mb-8 text-4xl font-black text-white">Free rap tools</h1>
  <div class="grid gap-4 md:grid-cols-2">
    {FREE_TOOLS.map((t) => (
      <a href={t.href} class="card hover:border-brand">
        <p class="text-xl font-bold text-white">{t.name}</p>
        <p class="mt-2 text-zinc-400">{t.blurb}</p>
        <span class="btn mt-4">Open →</span>
      </a>
    ))}
  </div>
</Base>
