---
import '../styles/global.css';
import { SITE } from '../lib/site';
import { ogImageFor } from '../lib/og-pages';
import { ORG_ID, WEBSITE_ID } from '../lib/schema';
import { isIndexable } from '../lib/indexing.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Full-bleed pages (games) manage their own width. */
  wide?: boolean;
  /** JSON-LD nodes; emitted as one @graph. */
  schema?: object[];
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false, wide = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';
const canonical = new URL(path, SITE.url).toString();
// Content first, brand last ("Suno vs Udio: Blind Test — RapRank").
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const ogImage = new URL(await ogImageFor(path), SITE.url).toString();
const robots = noindex || !isIndexable(path) ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Inner pages point at the site entities by @id instead of repeating them.
const graph = schema.map((node) => {
  const { '@context': _ctx, ...rest } = node as Record<string, unknown>;
  const isPage = ['WebPage', 'CollectionPage', 'FAQPage', 'WebApplication'].includes(rest['@type'] as string);
  return isPage && !rest.isPartOf ? { ...rest, isPartOf: { '@id': WEBSITE_ID }, publisher: { '@id': ORG_ID } } : rest;
});
const jsonLd = graph.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <!-- Google tag (gtag.js); is:inline so Astro ships it as-is -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YGXEE14YSK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-YGXEE14YSK');
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class={wide ? 'w-full flex-1' : 'mx-auto w-full max-w-6xl flex-1 px-4 py-10'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
