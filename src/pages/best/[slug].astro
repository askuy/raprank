---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CompareTable from '../../components/CompareTable.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import Faq from '../../components/Faq.astro';
import { getListTools, outboundRel, outboundUrl, pricingLabel } from '../../lib/data';
import { breadcrumbSchema, collectionPageSchema, faqSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  return (await getCollection('lists')).map((list) => ({ params: { slug: list.id }, props: { list } }));
}
const { list } = Astro.props;
const d = list.data;
const tools = await getListTools(list);
const crumbs = [{ name: 'Best Lists', href: '/best' }, { name: d.title, href: `/best/${list.id}` }];
const schema = [breadcrumbSchema(crumbs), collectionPageSchema(d.title, `/best/${list.id}`, d.description, tools), ...(d.faq.length ? [faqSchema(d.faq)] : [])];
---
<Base title={d.title} description={d.description} schema={schema}>
  <Breadcrumbs items={crumbs} />
  <h1 class="text-4xl font-black text-white">{d.title}</h1>
  <p class="mt-2 text-sm text-zinc-500">{tools.length} tools · last updated {SITE.updated}</p>
  <p class="mt-5 max-w-3xl text-lg text-zinc-400">{d.intro}</p>

  <h2 class="mb-4 mt-10 text-2xl font-bold text-white">Quick comparison</h2>
  <CompareTable tools={tools} />

  <div class="mt-14 space-y-6">
    {tools.map((t, i) => (
      <section id={t.id} class="card">
        <div class="flex flex-wrap items-center gap-4">
          <span class="text-3xl font-black text-zinc-700">{i + 1}</span>
          <ToolIcon tool={t} size={48} />
          <h2 class="flex-1 text-2xl font-bold"><a href={`/tool/${t.id}`} class="text-white hover:text-brand">{t.data.name}</a></h2>
          <a href={outboundUrl(t)} target="_blank" rel={outboundRel(t)} class="btn">Try it ↗</a>
        </div>
        <p class="mt-4 text-zinc-300">{t.data.tagline}.</p>
        <ul class="mt-3 list-inside list-disc text-sm text-zinc-400">{t.data.features.map((f) => <li>{f}</li>)}</ul>
        <p class="mt-3 text-sm"><span class="text-zinc-500">Pricing:</span> {pricingLabel(t.data.pricing)}{t.data.freeTier && ` · ${t.data.freeTier}`}</p>
      </section>
    ))}
  </div>
  <Faq items={d.faq} />
</Base>
