---
import Base from '../layouts/Base.astro';
import ToolGrid from '../components/ToolGrid.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { FREE_TOOLS } from '../lib/site';
import { formatDate, getListTools, getTree, outboundRel, outboundUrl } from '../lib/data';
import { getCollection, getEntry } from 'astro:content';
import { collectionPageSchema, siteNodes } from '../lib/schema';
import { battleTitle, getBattles } from '../lib/battles';

// Home targets "ai rap generator"; the ranked list page targets "best ai rap (song) generator".
const rapList = (await getEntry('lists', 'best-ai-rap-generator'))!;
const rapTools = (await getListTools(rapList)).slice(0, 6);
const mvList = (await getEntry('lists', 'best-ai-music-video-generator'))!;
const mvTools = (await getListTools(mvList)).slice(0, 6);
const tree = await getTree();
const lists = await getCollection('lists');
const battles = await getBattles();
const main = battles.find((x) => x.battle.id === 'suno-vs-udio') ?? battles[0];
const checked = formatDate(rapTools.map((t) => t.data.pricingCheckedAt).filter(Boolean).sort().at(-1));
const toolCount = tree.flatMap((g) => g.categories).reduce((n, c) => n + c.tools.length, 0);
const description = `Find the best AI rap generator for your track. We compare ${toolCount} AI rap and music tools by free plan, rap styles and commercial rights.`;
---
<Base
  title="AI Rap Generator: Compare the Best AI Rap Tools"
  description={description}
  schema={[...siteNodes(), collectionPageSchema('Best AI rap generators', '/', description, rapTools)]}
>
  <!-- Hero: answer "ai rap generator" first -->
  <section class="mb-12 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-brand">{toolCount} tools tracked{checked && ` · pricing checked ${checked}`}</p>
    <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-black tracking-tight text-white sm:text-6xl">AI Rap Generator: find the right one for your track</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-zinc-400">
      AI rap generators write the bars, make the beat and add rap vocals from a short prompt. Here's how the best ones compare on free plans, rap styles and commercial rights. Or start writing for free right now.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="#top-picks" class="btn px-6 py-3 text-lg">See the top AI rap generators</a>
      <a href="/rap-lyrics-generator" class="inline-flex items-center gap-2 rounded-lg border border-zinc-600 px-6 py-3 text-lg font-semibold text-white hover:border-brand">✍️ Free Rap Lyrics Generator</a>
    </div>
  </section>

  <!-- Top picks: compact ranking, full list one click away -->
  <section id="top-picks" class="mb-14 scroll-mt-6">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
      <h2 class="text-2xl font-bold text-white">Top AI rap generators right now</h2>
      <a href={`/best/${rapList.id}`} class="text-sm text-brand hover:underline">Full ranking of {rapList.data.tools?.length} AI rap song generators →</a>
    </div>
    <ol class="divide-y divide-zinc-800 overflow-hidden rounded-xl border border-zinc-800">
      {rapTools.map((t, i) => (
        <li class="flex flex-wrap items-center gap-4 bg-zinc-900/40 p-4 sm:flex-nowrap">
          <span class="w-6 text-xl font-black text-zinc-600">{i + 1}</span>
          <ToolIcon tool={t} size={40} />
          <div class="min-w-0 flex-1">
            <a href={`/tool/${t.id}`} class="font-semibold text-white hover:text-brand">{t.data.name}</a>
            <p class="text-sm text-zinc-400">{t.data.tagline}</p>
          </div>
          <p class="w-full text-xs text-emerald-400/90 sm:w-56">{t.data.freeTier ?? 'No free plan listed'}</p>
          <a href={outboundUrl(t)} target="_blank" rel={outboundRel(t)} class="shrink-0 rounded-lg border border-zinc-700 px-3 py-1.5 text-sm text-white hover:border-brand">Try ↗</a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Free tools: the transactional intent we can serve directly -->
  <section class="mb-14 grid gap-4 md:grid-cols-2">
    {FREE_TOOLS.map((t) => (
      <a href={t.href} class="card block hover:border-brand">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand">Free · no sign-up</p>
        <h2 class="mt-1 text-xl font-bold text-white">{t.name}</h2>
        <p class="mt-2 text-zinc-400">{t.blurb}</p>
      </a>
    ))}
  </section>

  <!-- Short explainer for the head term -->
  <section class="prose-rr mb-14 max-w-3xl space-y-4">
    <h2 class="text-2xl font-bold text-white">How to pick an AI rap generator</h2>
    <p><strong class="text-zinc-200">Decide what you need first.</strong> Some tools only write lyrics. Others make a full song with beat and vocals, and a few turn the song into a rap video. If you already write your own bars, Rap AI turns them into a song, and AI Rap Creator lets you edit its lyrics before it makes the audio.</p>
    <p><strong class="text-zinc-200">Check the free plan's limits, not just the word "free".</strong> Free plans differ a lot: daily credits, no downloads, watermarks, or personal use only. Every free plan in our lists is written out in full and dated.</p>
    <p><strong class="text-zinc-200">Commercial rights usually need a paid plan.</strong> If you plan to release the song or monetize the video, check the license before you generate. Suno, Rap AI and AIRapGen only grant commercial use on paid tiers.</p>
    <p><strong class="text-zinc-200">Match the style.</strong> Trap, drill and boom bap support varies by tool. Our <a href={`/best/${rapList.id}`} class="text-brand hover:underline">AI rap song generator ranking</a> lists the styles each one handles.</p>
  </section>

  <!-- Music video generators: biggest search demand next to rap generators -->
  <section class="mb-14">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
      <h2 class="text-2xl font-bold text-white">Turn the track into a video: AI music video generators</h2>
      <a href={`/best/${mvList.id}`} class="text-sm text-brand hover:underline">Compare all AI music video generators →</a>
    </div>
    <ToolGrid tools={mvTools} />
  </section>

  <!-- The fun part, one scroll down -->
  <section class="relative mb-14 overflow-hidden rounded-3xl border border-zinc-800 bg-[radial-gradient(ellipse_at_15%_0%,rgba(249,115,22,.22),transparent_55%),radial-gradient(ellipse_at_85%_0%,rgba(56,189,248,.18),transparent_55%)] px-6 py-10 text-center sm:px-10">
    <p class="font-mono text-xs uppercase tracking-[.35em] text-zinc-400">Tonight's main event</p>
    <div class="mt-6 grid grid-cols-[1fr_auto_1fr] items-center gap-3">
      <div class="flex flex-col items-center gap-2">
        <div class="rounded-full p-1 ring-4 ring-brand/50"><ToolIcon tool={main.a} size={72} /></div>
        <p class="text-xl font-black uppercase text-white sm:text-3xl">{main.a.data.name}</p>
      </div>
      <span class="text-5xl font-black italic text-brand drop-shadow-[0_0_25px_rgba(249,115,22,.7)] sm:text-7xl">VS</span>
      <div class="flex flex-col items-center gap-2">
        <div class="rounded-full p-1 ring-4 ring-sky-400/50"><ToolIcon tool={main.b} size={72} /></div>
        <p class="text-xl font-black uppercase text-white sm:text-3xl">{main.b.data.name}</p>
      </div>
    </div>
    <div class="mx-auto mt-6 grid max-w-3xl gap-4 text-left font-mono text-sm sm:grid-cols-2">
      <p class="rounded-xl border border-brand/30 bg-zinc-950/70 p-4 text-orange-200">🎤 {main.battle.data.roast.a[0]}<br />{main.battle.data.roast.a[1]}</p>
      <p class="rounded-xl border border-sky-400/30 bg-zinc-950/70 p-4 text-sky-200">🎤 {main.battle.data.roast.b[0]}<br />{main.battle.data.roast.b[1]}</p>
    </div>
    <h2 class="mt-8 text-2xl font-black text-white sm:text-3xl">AI rap battles: make two tools roast each other</h2>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={`/arena?a=${main.a.id}&b=${main.b.id}`} class="btn px-6 py-3">🎤 Start this battle</a>
      <a href={`/battle/${main.battle.id}`} class="inline-flex items-center gap-2 rounded-lg border border-zinc-600 px-6 py-3 font-semibold text-white hover:border-brand">🎧 {battleTitle(main.a, main.b)} blind test</a>
    </div>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm">
      {battles.filter((x) => x !== main).map(({ battle, a, b }) => <a href={`/battle/${battle.id}`} class="chip">{battleTitle(a, b)}</a>)}
      <a href="/arena" class="chip border-brand text-brand">🎲 Random matchup</a>
    </div>
  </section>

  <section class="mb-14 grid gap-6 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-3 text-xl font-bold text-white">Ranked lists</h2>
      <ul class="space-y-2">
        {lists.map((l) => <li><a href={`/best/${l.id}`} class="text-zinc-300 hover:text-brand">{l.data.title}</a></li>)}
      </ul>
    </div>
    <div class="card">
      <h2 class="mb-3 text-xl font-bold text-white">Browse by category</h2>
      <ul class="space-y-2">
        {tree.flatMap(({ categories }) => categories).map(({ category, tools }) => (
          <li class="flex justify-between">
            <a href={`/category/${category.id}`} class="text-zinc-300 hover:text-brand">{category.data.name}</a>
            <span class="text-zinc-600">{tools.length}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
