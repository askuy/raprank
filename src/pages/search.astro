---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { getTools, pricingLabel } from '../lib/data';
const tools = await getTools();
const index = await Promise.all(
  tools.map(async (t) => {
    const category = (await getEntry(t.data.category))!;
    return {
      id: t.id,
      name: t.data.name,
      tagline: t.data.tagline,
      category: category.data.name,
      pricing: pricingLabel(t.data.pricing),
      text: [t.data.name, t.data.tagline, category.data.name, t.data.features.join(' '), t.data.tags.map((x) => x.id).join(' '), t.data.pricing ?? ''].join(' ').toLowerCase(),
    };
  }),
);
---
<Base title="Search AI Rap & Music Video Tools" description="Search every AI rap and music video tool in the RapRank directory." noindex>
  <h1 class="mb-6 text-4xl font-black text-white">Search</h1>
  <input id="q" type="search" autofocus placeholder="Try: lip-sync, free, drill, suno…" class="w-full rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-3 text-lg text-white placeholder:text-zinc-500 focus:border-brand focus:outline-none" />
  <p id="count" class="mt-3 text-sm text-zinc-500"></p>
  <ul id="results" class="mt-6 grid gap-3 sm:grid-cols-2"></ul>
  <script is:inline type="application/json" id="index" set:html={JSON.stringify(index)} />
  <script>
    type Item = { id: string; name: string; tagline: string; category: string; pricing: string; text: string };
    const index: Item[] = JSON.parse(document.getElementById('index')!.textContent!);
    const input = document.getElementById('q') as HTMLInputElement;
    const results = document.getElementById('results')!;
    const count = document.getElementById('count')!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    function render() {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      const hits = index.filter((it) => terms.every((t) => it.text.includes(t)));
      count.textContent = `${hits.length} tool${hits.length === 1 ? '' : 's'}`;
      results.innerHTML = hits
        .map((it) => `<li><a href="/tool/${it.id}" class="card block hover:border-zinc-600"><p class="font-semibold text-white">${esc(it.name)}</p><p class="text-xs text-zinc-500">${esc(it.category)} · ${esc(it.pricing)}</p><p class="mt-2 text-sm text-zinc-400">${esc(it.tagline)}</p></a></li>`)
        .join('');
      const url = new URL(location.href);
      input.value ? url.searchParams.set('q', input.value) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }
    input.value = new URLSearchParams(location.search).get('q') ?? '';
    input.addEventListener('input', render);
    render();
  </script>
</Base>
