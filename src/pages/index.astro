---
import Base from '../layouts/Base.astro';
import ToolGrid from '../components/ToolGrid.astro';
import { SITE, FREE_TOOLS } from '../lib/site';
import { getTree, getTools } from '../lib/data';
import { getCollection } from 'astro:content';
import { itemListSchema } from '../lib/schema';
import { battleTitle, getBattles } from '../lib/battles';
import ToolIcon from '../components/ToolIcon.astro';

const tree = await getTree();
const tools = await getTools();
const rapVideo = tools.filter((t) => t.data.category.id === 'ai-rap-video');
const lists = await getCollection('lists');
const battles = await getBattles();
const main = battles.find((x) => x.battle.id === 'suno-vs-udio') ?? battles[0];
---
<Base
  title="RapRank: AI Rap Battles & the AI Rap Video Generator Directory"
  description={SITE.description}
  schema={[
    { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url,
      potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/search?q={q}`, 'query-input': 'required name=q' } },
    itemListSchema('AI Rap Video Generators', rapVideo),
  ]}
>
  <!-- Hero: the main event is a battle -->
  <section class="relative mb-10 overflow-hidden rounded-3xl border border-zinc-800 bg-[radial-gradient(ellipse_at_15%_0%,rgba(249,115,22,.25),transparent_55%),radial-gradient(ellipse_at_85%_0%,rgba(56,189,248,.2),transparent_55%)] px-6 py-10 text-center sm:px-10 sm:py-14">
    <p class="font-mono text-xs uppercase tracking-[.35em] text-zinc-400">Tonight's main event</p>
    <div class="mt-8 grid grid-cols-[1fr_auto_1fr] items-center gap-3">
      <div class="flex flex-col items-center gap-3">
        <div class="rounded-full p-1 ring-4 ring-brand/50"><ToolIcon tool={main.a} size={96} /></div>
        <p class="text-2xl font-black uppercase text-white sm:text-4xl">{main.a.data.name}</p>
      </div>
      <span class="text-6xl font-black italic text-brand drop-shadow-[0_0_25px_rgba(249,115,22,.7)] sm:text-8xl">VS</span>
      <div class="flex flex-col items-center gap-3">
        <div class="rounded-full p-1 ring-4 ring-sky-400/50"><ToolIcon tool={main.b} size={96} /></div>
        <p class="text-2xl font-black uppercase text-white sm:text-4xl">{main.b.data.name}</p>
      </div>
    </div>
    <div class="mx-auto mt-8 grid max-w-3xl gap-4 text-left font-mono text-sm sm:grid-cols-2">
      <p class="rounded-xl border border-brand/30 bg-zinc-950/70 p-4 text-orange-200">🎤 {main.battle.data.roast.a[0]}<br />{main.battle.data.roast.a[1]}</p>
      <p class="rounded-xl border border-sky-400/30 bg-zinc-950/70 p-4 text-sky-200">🎤 {main.battle.data.roast.b[0]}<br />{main.battle.data.roast.b[1]}</p>
    </div>
    <h1 class="mx-auto mt-10 max-w-3xl text-3xl font-black tracking-tight text-white sm:text-5xl">AI rap tools, battling it out</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-zinc-400">Pick any two AI rap and music video tools and make them roast each other over a beat. Then listen to their real outputs blind and vote for the winner.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={`/arena?a=${main.a.id}&b=${main.b.id}`} class="btn px-6 py-3 text-lg">🎤 Start this battle</a>
      <a href={`/battle/${main.battle.id}`} class="inline-flex items-center gap-2 rounded-lg border border-zinc-600 px-6 py-3 text-lg font-semibold text-white hover:border-brand">🎧 Blind test the real tracks</a>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3 text-sm">
      <span class="text-zinc-500">More fights:</span>
      {battles.filter((x) => x !== main).map(({ a, b }) => (
        <a href={`/arena?a=${a.id}&b=${b.id}`} class="chip">{battleTitle(a, b)}</a>
      ))}
      <a href="/arena" class="chip border-brand text-brand">🎲 Random matchup</a>
    </div>
  </section>

  <form action="/search" class="mx-auto mb-14 flex max-w-lg gap-2">
    <input name="q" type="search" placeholder={`Search ${tools.length} AI tools, e.g. lip-sync, free, suno…`} class="flex-1 rounded-lg border border-zinc-700 bg-zinc-900 px-4 py-2 text-white placeholder:text-zinc-500 focus:border-brand focus:outline-none" />
    <button class="btn">Search</button>
  </form>

  <section class="mb-14">
    <div class="mb-5 flex items-end justify-between">
      <h2 class="text-2xl font-bold text-white">AI Rap Video Generators</h2>
      <a href="/best/best-ai-rap-video-generator" class="text-sm text-brand hover:underline">See the ranked list →</a>
    </div>
    <ToolGrid tools={rapVideo.slice(0, 9)} />
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-2xl font-bold text-white">Browse the directory</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {tree.map(({ group, categories }) => (
        <div class="card">
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-zinc-500">{group.data.name}</p>
          <ul class="space-y-2">
            {categories.map(({ category, tools }) => (
              <li class="flex justify-between">
                <a href={`/category/${category.id}`} class="text-zinc-200 hover:text-brand">{category.data.name}</a>
                <span class="text-zinc-600">{tools.length}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-14 grid gap-6 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-3 text-xl font-bold text-white">Best-of lists</h2>
      <ul class="space-y-2">
        {lists.map((l) => <li><a href={`/best/${l.id}`} class="text-zinc-300 hover:text-brand">{l.data.title}</a></li>)}
      </ul>
    </div>
    <div class="grid gap-6">
      {FREE_TOOLS.map((t) => (
        <a href={t.href} class="card block hover:border-brand">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand">Free tool</p>
          <h2 class="mt-1 text-xl font-bold text-white">{t.name}</h2>
          <p class="mt-2 text-zinc-400">{t.blurb}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
