---
import Base from '../layouts/Base.astro';
import { LISTING } from '../lib/site';

const body = encodeURIComponent(
  'Tool name:\nURL:\nOne-line description:\nCategory (rap video / music video / rap song / voice / lyrics):\nPricing & free tier:\n3-5 key features:\nPlan (Free / Badge / Sponsored):\n',
);
const mail = (plan: string) => `mailto:${LISTING.contact}?subject=${encodeURIComponent(`RapRank listing: ${plan}`)}&body=${body}`;
const tiers = [
  {
    name: 'Free listing',
    price: 'Free',
    points: ['Your own tool page plus a spot in your category', 'Can be picked for battles and best-of lists', 'Standard link (nofollow)', 'Reviewed in the order we receive submissions'],
    cta: 'Submit on GitHub',
    href: LISTING.submitUrl,
  },
  {
    name: 'Verified (badge)',
    price: 'Free, just link back',
    points: ['Everything in Free', 'Add the RapRank badge to your site', '✓ Verified mark and a higher spot in your category', 'Followed link (no nofollow)'],
    cta: 'Get the badge',
    href: '/badge',
    highlight: true,
  },
  {
    name: 'Sponsored',
    price: LISTING.sponsorPrice,
    points: ['Pinned at the top of your category and on the home page', 'Featured in the Arena hot matchups', 'A blind-test battle against a competitor (first-generation outputs, clearly labeled)', 'Link marked rel="sponsored", as Google requires'],
    cta: 'Apply on GitHub',
    href: LISTING.submitUrl,
  },
];
---
<Base title="Submit Your AI Tool to RapRank" description="List your AI rap, music video, voice or lyrics tool on RapRank. Free listing, Verified badge listing, or Sponsored placement.">
  <div class="mx-auto max-w-5xl">
    <h1 class="text-center text-4xl font-black text-white">Get your AI tool on RapRank</h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-lg text-zinc-400">We list AI tools for rap videos, music videos, rap songs, rapper voices and lyrics. Every submission is checked by a person before it goes live.</p>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {tiers.map((t) => (
        <div class={`card flex flex-col ${t.highlight ? 'border-brand' : ''}`}>
          <p class="text-lg font-bold text-white">{t.name}</p>
          <p class="mt-1 text-2xl font-black text-brand">{t.price}</p>
          <ul class="mt-4 flex-1 space-y-2 text-sm text-zinc-300">{t.points.map((p) => <li>• {p}</li>)}</ul>
          <a href={t.href} class={`mt-6 justify-center ${t.highlight ? 'btn' : 'inline-flex rounded-lg border border-zinc-600 px-4 py-2 font-semibold text-white hover:border-brand'}`}>{t.cta}</a>
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-sm text-zinc-500">Submissions go through a short GitHub form, and you'll get updates on your issue. No GitHub account? Email <a href={mail('Submission')} class="text-brand hover:underline">{LISTING.contact}</a>.</p>
    <section class="prose-rr mx-auto mt-12 max-w-3xl space-y-3">
      <h2 class="text-2xl font-bold text-white">How it works</h2>
      <p>1. Fill in the GitHub form. 2. We review it, usually within a few days. 3. Once approved, your tool page goes live automatically and we comment on your issue with the link.</p>
      <h2 class="text-2xl font-bold text-white">What we don't list</h2>
      <p>Sites that don't load, aren't related to AI music or rap, are thin wrappers with no product of their own, or host adult or pirated content. Paid plans never change a battle result or a ranking in a blind test.</p>
    </section>
  </div>
</Base>
